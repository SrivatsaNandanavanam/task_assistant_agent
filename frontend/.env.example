# Backend origin the browser should call. Vite reads this at BUILD time (not at runtime).
#
# Local development: leave it empty. The Vite dev server proxies /api to http://localhost:8000.
# Production (Vercel): set it in the frontend project's Environment Variables, then redeploy:
#   VITE_API_BASE_URL=https://your-backend.vercel.app
# Use the origin only: no trailing slash and no /api (the app adds /api/... itself).
VITE_API_BASE_URL=
